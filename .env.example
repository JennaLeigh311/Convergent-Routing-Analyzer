# Copy to .env and adjust. The dev (core) profile needs none of these;
# they are consumed by the data/full profiles and their adapters.

# --- Kafka (full profile) ---
KAFKA_BROKER=localhost:9092
# In-compose, containers reach Kafka by service name; the pipeline service uses
# this instead of KAFKA_BROKER (which targets the host).
KAFKA_BROKER_INTERNAL=kafka:9092
TOPIC_GPS_PINGS=gps-pings
TOPIC_SEGMENT_CONGESTION=segment-congestion

# --- PostGIS / pgRouting (data profile) ---
PG_DSN=postgres://routing:routing@localhost:5432/routing?sslmode=disable
# Postgres role/db the postgis container provisions; keep in sync with PG_DSN.
POSTGRES_USER=routing
POSTGRES_PASSWORD=routing
POSTGRES_DB=routing

# --- Published host ports (docker-compose; override on port conflicts) ---
ROUTING_SERVER_PORT=8080   # host port -> engine :8080
WEB_PORT=3000              # host port -> web   :80
PG_PORT=5432               # host port -> postgis :5432
KAFKA_HOST_PORT=9092       # host port -> kafka host listener (:29092); reach it at localhost:9092

# --- GPS replay (replay command) ---
REPLAY_SPEED=10          # wall-clock compression factor (10x real time)
REPLAY_DATASET=porto     # porto | tdrive

# --- Routing server ---
ROUTING_SERVER_ADDR=:8080
# REST surface auth: static bearer token. Unset/empty => auth DISABLED (the open
# demo/dev default). When set, routing endpoints require `Authorization: Bearer <token>`
# (health/metrics stay exempt). See docs/api.md.
# ROUTING_API_TOKEN=
# Per-client token-bucket rate limit (defaults shown). RPS <= 0 disables limiting.
ROUTING_RATE_LIMIT_RPS=20
ROUTING_RATE_LIMIT_BURST=40

# --- Logging (all binaries) ---
LOG_LEVEL=info           # debug | info | warn | error
LOG_FORMAT=text          # text (dev) | json (aggregation)
