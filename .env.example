# Copy to .env and adjust. The dev (core) profile needs none of these;
# they are consumed by the data/full profiles and their adapters.

# --- Kafka (full profile) ---
KAFKA_BROKER=localhost:9092
TOPIC_GPS_PINGS=gps-pings
TOPIC_SEGMENT_CONGESTION=segment-congestion

# --- PostGIS / pgRouting (data profile) ---
PG_DSN=postgres://routing:routing@localhost:5432/routing?sslmode=disable

# --- GPS replay (replay command) ---
REPLAY_SPEED=10          # wall-clock compression factor (10x real time)
REPLAY_DATASET=porto     # porto | tdrive

# --- Routing server ---
ROUTING_SERVER_ADDR=:8080

# --- Logging (all binaries) ---
LOG_LEVEL=info           # debug | info | warn | error
LOG_FORMAT=text          # text (dev) | json (aggregation)
